---
import ProjectCards from '../components/ProjectCards.astro';
import NowBoxes from '../components/NowBoxes.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import { phishcritPosts, blogPosts, fmtDate } from '../lib/content';
import { allBylines, sectionInfo, fmtIso } from '../lib/bylines';

const pc = (await phishcritPosts()).map((p) => ({ date: p.data.published, kind: 'PhishCrit', cls: 'pc', title: p.data.title, dek: p.data.summary ?? p.data.subtitle, href: `/phishcrit/${p.id}/` }));
const bl = (await blogPosts()).map((p) => ({ date: p.data.published, kind: 'Blog', cls: 'blog', title: p.data.title, dek: p.data.summary, href: `/blog/${p.id}/` }));
const latest = [...pc, ...bl].sort((a, b) => +b.date - +a.date).slice(0, 3);
// The blogs column shows only once PhishCrit (Phase 6) or the blog (Phase 7) has posts on this site.
const bylines = allBylines().slice(0, latest.length ? 3 : 5);
---
<BaseLayout section="var(--phishcrit)">
  <section class="wrap hero">
    <HeroBand />
    <h1><span>Music writing,</span> <span>science writing,</span> <span>and side projects</span></h1>
  </section>

  <section class="wrap latest">
    <div class="cols">
      {latest.length > 0 && <div>
        <h2 class="section-head" style="--section: var(--blog)">
          From the blogs
        </h2>
        {latest.map((p) => (
          <a class="entry" href={p.href}>
            <span class="meta"><span>{fmtDate(p.date)}</span><span class={`pod pod-${p.cls}`}>{p.kind}</span></span>
            <span class="body"><span class="title">{p.title}</span>{p.dek && <span>{p.dek}</span>}</span>
          </a>
        ))}
      </div>}
      <div>
        <h2 class="section-head" style="--section: var(--bylines)">
          Recent bylines
        </h2>
        {bylines.map((b) => (
          <a class="entry" href={b.url ?? `/bylines/${b.section}/`}>
            <span class="meta"><span>{fmtIso(b.date)}</span><span class={`pod pod-${b.section}`}>{sectionInfo(b.section).label}</span></span>
            <span class="body"><span class="title">{b.title}</span><span>{b.outlet}</span></span>
          </a>
        ))}
        <a class="more" href="/bylines/">All bylines →</a>
      </div>
    </div>
  </section>

  <section class="wrap lately" style="--section: var(--music)">
    <h2 class="section-head">Lately</h2>
    <NowBoxes />
  </section>

  <section class="wrap" style="--section: var(--projects)">
    <h2 class="section-head">Projects</h2>
    <ProjectCards />
  </section>
</BaseLayout>

<style>
  .hero { padding-top: 56px; padding-bottom: 48px; }
  .hero h1 { margin: 40px 0 0; font-size: var(--fs-title); line-height: 1.05; letter-spacing: -0.02em; max-width: 24ch; }
  .latest { padding-top: 8px; padding-bottom: 64px; }
  .latest .section-head { margin-bottom: 8px; }
  .lately { padding-bottom: 64px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 48px; }
  .entry { display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: 20px; padding: 18px 0; border-top: 2px solid var(--ink); }
  .meta { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; font-size: var(--fs-small); }
  .body { display: flex; flex-direction: column; gap: 6px; }
  .title { font-size: var(--fs-head); font-weight: 800; line-height: 1.15; }
  .pod-pc { background: var(--phishcrit); }
  .pod-blog { background: var(--blog); color: var(--ink); }
  .pod-music { background: var(--music); }
  .pod-science { background: var(--science); color: var(--ink); }
  .pod-news { background: var(--news); }
  .pod-podcasts { background: var(--podcasts); color: var(--ink); }
  .more { display: inline-block; margin-top: 16px; font-weight: 800; color: var(--bylines-text); }
</style>
