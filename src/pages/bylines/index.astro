---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BylinesHeader from '../../components/BylinesHeader.astro';
import BylineRow from '../../components/BylineRow.astro';
import { allBylines, pageIntro } from '../../lib/bylines';
const recent = allBylines().slice(0, 10);
---
<BaseLayout title="Bylines" section="var(--bylines)" description="Rob Mitchum's published writing and podcast work: music, science, news and podcasts.">
  <div class="wrap">
    <BylinesHeader title="Bylines" color="var(--bylines-text)">
      <p slot="intro" class:list={['intro', { placeholder: !pageIntro('bylines') }]}>{pageIntro('bylines') ?? '[A line introducing your published writing and podcast work.]'}</p>
    </BylinesHeader>


    <section class="recent" style="--section: var(--bylines)">
      <h2 class="section-head">Recent</h2>
      <ul class="rows">{recent.map((b) => <BylineRow b={b} mode="hub" />)}</ul>
      <div class="end-rule"></div>
    </section>
  </div>
</BaseLayout>

<style>
  .placeholder { color: var(--muted); }
  .recent { margin-top: 24px; }
  .rows { padding: 0; margin: 0; }
  .end-rule { border-top: 2px solid var(--ink); }
</style>
