---
import { buyUrl, listenUrl, type Album } from '../../lib/aoty';
interface Props { album: Album; small?: boolean }
const { album, small = false } = Astro.props;
const buy = buyUrl(album);
const cls = small ? 'pill pill--sm' : 'pill';
const name = `${album.title} by ${album.artist}`;
---
{buy && <a class={cls} href={buy} aria-label={`Buy ${name} on Bandcamp`}>Buy <span aria-hidden="true">↗</span></a>}
<a class={cls} href={listenUrl(album)} aria-label={`Listen to ${name}`}>Listen <span aria-hidden="true">↗</span></a>
