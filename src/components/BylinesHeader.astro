---
// Bylines page header (simplified 2026-11-23 after Andrew's review): title at the
// left edge, one line of intro, and section pods that link to each section.
import { SECTIONS, type SectionId, bylines } from '../lib/bylines';
interface Props { current?: SectionId; title: string; meta?: string; color: string; intro?: string; pills?: boolean }
const { current, title, meta, color, intro, pills: showPills = true } = Astro.props;
const pills = [{ id: undefined, label: 'All', href: '/bylines/', dot: 'var(--bylines)', n: Object.values(bylines).flat().length },
  ...SECTIONS.map((s) => ({ id: s.id, label: s.label, href: `/bylines/${s.id}/`, dot: s.color, n: bylines[s.id].length }))];
---
<section class="bh">
  <div class="bh-main">
    <div>
      <h1 style={`color:${color}`}>{title}</h1>
      {current && meta && <p class="sub">{meta}</p>}
    </div>
    {intro ? <p class="intro">{intro}</p> : <slot name="intro" />}
    {showPills && <nav class="pills" aria-label="Bylines sections">
      {pills.map((p) => (
        <a href={p.href} aria-current={p.id === current ? 'page' : undefined}>
          <span class="dot" style={`background:${p.dot}`}></span>{p.label}<span class="n">{p.n.toLocaleString('en-US')}</span>
        </a>
      ))}
    </nav>}
  </div>
</section>

<style>
  .bh { padding: 56px 0 48px; }
  .bh-main { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  h1 { margin: 0; font-size: var(--fs-title); line-height: 1; letter-spacing: -0.02em; }
  .sub { margin: 8px 0 0; font-size: var(--fs-small); font-weight: 800; }
  .intro, .bh-main :global(.intro) { margin: 0; font-size: var(--fs-body); line-height: 1.5; max-width: 60ch; }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .pills a { font-size: var(--fs-body); font-weight: 800; padding: 10px 20px; min-height: 44px; border-radius: 999px; border: 2px solid var(--ink); display: flex; align-items: center; gap: 10px; }
  .pills a:hover { color: var(--ink); background: #fff; }
  .pills a[aria-current='page'] { background: var(--ink); color: #fff; }
  .pills a[aria-current='page'] .dot { background: #fff !important; }
  .dot { display: block; width: 12px; height: 12px; border-radius: 50%; }
  .n { font-weight: 400; font-size: var(--fs-small); opacity: 0.75; }
  @media (max-width: 720px) { .bh { padding-top: 40px; } }
</style>
