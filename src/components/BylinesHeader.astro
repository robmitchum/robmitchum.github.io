---
// Bylines page header (approved mockup): small stacked meta label, Lanes icon,
// big title, one line of intro, and section pods that link to each section.
import SectionIcon from './SectionIcon.astro';
import { SECTIONS, type SectionId, bylines } from '../lib/bylines';
interface Props { current?: SectionId; title: string; meta: string; color: string; intro?: string }
const { current, title, meta, color, intro } = Astro.props;
const pills = [{ id: undefined, label: 'All', href: '/bylines/', dot: 'var(--bylines)', n: Object.values(bylines).flat().length },
  ...SECTIONS.map((s) => ({ id: s.id, label: s.label, href: `/bylines/${s.id}/`, dot: s.color, n: bylines[s.id].length }))];
---
<section class="bh">
  <div class="bh-meta"><span>Bylines</span><span class="b">{meta}</span></div>
  <div class="bh-main">
    <div class="bh-title">
      <SectionIcon name={current ?? 'bylines'} size={96} />
      <h1 style={`color:${color}`}>{title}</h1>
    </div>
    {intro ? <p class="intro">{intro}</p> : <slot name="intro" />}
    <nav class="pills" aria-label="Bylines sections">
      {pills.map((p) => (
        <a href={p.href} aria-current={p.id === current ? 'page' : undefined}>
          <span class="dot" style={`background:${p.dot}`}></span>{p.label}<span class="n">{p.n.toLocaleString('en-US')}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .bh { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; padding: 72px 0 56px; }
  .bh-meta { display: flex; flex-direction: column; font-size: 13px; line-height: 1.3; padding-top: 14px; }
  .b { font-weight: 800; }
  .bh-main { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .bh-title { display: flex; align-items: flex-end; gap: 28px; flex-wrap: wrap; }
  h1 { margin: 0; font-size: clamp(56px, 9vw, 96px); line-height: 0.95; letter-spacing: -0.025em; }
  .intro, .bh-main :global(.intro) { margin: 0; font-size: 20px; line-height: 1.5; max-width: 52ch; }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .pills a { font-size: 16px; font-weight: 800; padding: 10px 20px; min-height: 44px; border-radius: 999px; border: 2px solid var(--ink); display: flex; align-items: center; gap: 10px; }
  .pills a:hover { color: var(--ink); background: #fff; }
  .pills a[aria-current='page'] { background: var(--ink); color: #fff; }
  .pills a[aria-current='page'] .dot { background: #fff !important; }
  .dot { display: block; width: 12px; height: 12px; border-radius: 50%; }
  .n { font-weight: 400; font-size: 13px; opacity: 0.75; }
  @media (max-width: 720px) {
    .bh { grid-template-columns: 1fr; padding-top: 48px; gap: 12px; }
    .bh-meta { flex-direction: row; gap: 8px; padding: 0; }
    .bh-title :global(svg) { width: 64px; height: 64px; }
  }
</style>
